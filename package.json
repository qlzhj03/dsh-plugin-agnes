{
  "name": "@local/dsh-agnes-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Agnes text, image, and video generation with in-chat previews and a persistent media history.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlzhj03/dsh-plugin-agnes.git"
  },
  "homepage": "https://github.com/qlzhj03/dsh-plugin-agnes#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
